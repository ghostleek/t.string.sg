{
  "name": "t-string-sg",
  "version": "1.0.0",
  "private": true,
  "description": "Link shortener for t.string.sg with click analytics",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply t-string-sg --local",
    "db:migrate:remote": "wrangler d1 migrations apply t-string-sg --remote"
  },
  "dependencies": {
    "hono": "^4.12.28"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.1"
  }
}
