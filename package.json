{
  "name": "t-string-sg",
  "version": "1.0.0",
  "private": true,
  "description": "Link shortener for t.string.sg with click analytics",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply t-string-sg --local",
    "db:migrate:remote": "wrangler d1 migrations apply t-string-sg --remote"
  },
  "dependencies": {
    "hono": "^4.12.28",
    "qrcode-generator": "^2.0.4"
  },
  "overrides": {
    "postcss": "^8.5.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "@types/qrcode-generator": "^0.0.16",
    "jsqr": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.116.0"
  }
}
